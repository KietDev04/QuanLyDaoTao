@model QuanLyDaoTaoWeb.Models.LopHoc

@{
    ViewData["Title"] = "Thêm Lớp Học";
    Layout= "~/Views/Shared/_Layout.cshtml";
}

<div class="page-container">
    <div class="page-header">
        <h1 class="page-title">Thêm Mới Lớp Học</h1>
    </div>

    <div class="card">
        <div class="card-header bg-primary text-white">
            <h2 class="card-title">Thông Tin Lớp Học</h2>
        </div>

        <div class="card-body">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">
                    <label asp-for="MaLop" class="control-label">Mã Lớp</label>
                    <input asp-for="MaLop" class="form-control" />
                    <span asp-validation-for="MaLop" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="TenLop" class="control-label">Tên Lớp</label>
                    <input asp-for="TenLop" class="form-control" />
                    <span asp-validation-for="TenLop" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="MaCTDT" class="control-label">Chương Trình Đào Tạo</label>
                    <select asp-for="MaCTDT" asp-items="ViewBag.ChuongTrinhDaoTaoList" class="form-control select2">
                        <option value="">-- Chọn Chương Trình Đào Tạo --</option>
                    </select>
                    <span asp-validation-for="MaCTDT" class="text-danger"></span>
                </div>

                <div class="form-group d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Lưu
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function () {
            $('.select2').select2({
                theme: 'default',
                placeholder: '-- Chọn Chương Trình Đào Tạo --'
            });
        });
    </script>
}
