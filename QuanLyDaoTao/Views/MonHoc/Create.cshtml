@model QuanLyDaoTaoWeb.Models.MonHoc

@{
    ViewData["Title"] = "Thêm Môn Học";
    Layout= "~/Views/Shared/_Layout.cshtml";
}

<div class="page-container">
    <div class="page-header">
        <h1 class="page-title">Thêm Mới Môn Học</h1>
    </div>

    <div class="card">
        <div class="card-header bg-primary text-white">
            <h2 class="card-title">Thông Tin Môn Học</h2>
        </div>

        <div class="card-body">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">
                    <label asp-for="MaMH" class="control-label">Mã Môn Học</label>
                    <input asp-for="MaMH" class="form-control" />
                    <span asp-validation-for="MaMH" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="TenMH" class="control-label">Tên Môn Học</label>
                    <input asp-for="TenMH" class="form-control" />
                    <span asp-validation-for="TenMH" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="SoTinChi" class="control-label">Số Tín Chỉ</label>
                    <input asp-for="SoTinChi" class="form-control" type="number" min="1" max="10" />
                    <span asp-validation-for="SoTinChi" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="MaKhoa" class="control-label">Khoa</label>
                    <select asp-for="MaKhoa" asp-items="ViewBag.KhoaList" class="form-control select2">
                        <option value="">-- Chọn Khoa --</option>
                    </select>
                    <span asp-validation-for="MaKhoa" class="text-danger"></span>
                </div>

                <div class="form-group d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Lưu
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function () {
            $('.select2').select2({
                theme: 'default',
                placeholder: '-- Chọn Khoa --'
            });
        });
    </script>
}
