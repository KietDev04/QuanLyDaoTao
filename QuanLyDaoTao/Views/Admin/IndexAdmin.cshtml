@{
    ViewData["Title"] = "Trang Quản Lý";
}

@{
    var menuItems = new[] {
        new { Icon = "fas fa-university", Title = "Quản Lý Khoa", Text = "Quản lý thông tin các khoa", Action = "KhoaIndex" },
        new { Icon = "fas fa-user-graduate", Title = "Quản Lý Sinh Viên", Text = "Quản lý thông tin sinh viên", Action = "SinhVienIndex" },
        new { Icon = "fas fa-chalkboard-teacher", Title = "Quản Lý Giảng Viên", Text = "Quản lý thông tin giảng viên", Action = "GiangVienIndex" },
        new { Icon = "fas fa-book", Title = "Quản Lý Lớp Học", Text = "Quản lý thông tin lớp học", Action = "LopHocIndex" },
        new { Icon = "fas fa-book", Title = "Quản Lý Môn Học", Text = "Quản lý thông tin môn học", Action = "MonHocIndex" },
        new { Icon = "fas fa-book", Title = "Quản Lý Tài Liệu", Text = "Quản lý thông tin tài liệu", Action = "TaiLieuIndex" },
        new { Icon = "fas fa-book", Title = "Quản Lý Đề Cương", Text = "Quản lý thông tin đề cương", Action = "DeCuongIndex" },
        new { Icon = "fas fa-book", Title = "Quản Lý Bài Giảng", Text = "Quản lý thông tin bài giảng", Action = "BaiGiangIndex" },
        new { Icon = "fas fa-book", Title = "Quản Lý Chương Trình Đào Tạo", Text = "Quản lý thông tin chương trình đào tạo", Action = "ChuongTrinhDaoTaoIndex" },
        new { Icon = "fas fa-book", Title = "Quản Lý Đăng Ký Lớp Học", Text = "Quản lý thông tin đăng ký lớp học", Action = "DangKyLopHocIndex" },
        new { Icon = "fas fa-book", Title = "Quản Lý Phân Công Giảng Dạy", Text = "Quản lý thông tin phân công giảng dạy", Action = "PhanCongGiangDayIndex" },
        new { Icon = "fas fa-book", Title = "Quản Lý Đánh Giá", Text = "Quản lý thông tin đánh giá", Action = "DanhGiaIndex" }
    };
}

<div class="container-fluid py-4">
    <div class="card shadow mb-4">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Trang Quản Lý Hệ Thống Đào Tạo</h5>
            <input type="text" id="searchInput" class="form-control w-25" placeholder="Tìm kiếm danh mục...">
        </div>
        <div class="card-body">
            <div class="row g-4" id="menuContainer">
                @foreach (var item in menuItems)
                {
                    <div class="col-md-3 menu-item">
                        <div class="card h-100">
                            <div class="card-body text-center">
                                <i class="@item.Icon fa-3x mb-3 text-primary"></i>
                                <h5 class="card-title">@item.Title</h5>
                                <p class="card-text">@item.Text</p>
                                <a asp-action="@item.Action" asp-controller="Admin" class="btn btn-warning">
                                    <i class="fas fa-arrow-right"></i> Truy cập
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="mt-4">
                <a asp-action="ApproveGiangVien" class="btn btn-outline-primary">
                    <i class="fas fa-user-check"></i> Phê duyệt tài khoản Giảng viên
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("searchInput").addEventListener("input", function () {
            let searchValue = this.value.toLowerCase();
            let items = document.querySelectorAll(".menu-item");
            
            items.forEach(item => {
                let title = item.querySelector(".card-title").innerText.toLowerCase();
                let text = item.querySelector(".card-text").innerText.toLowerCase();
                
                if (title.includes(searchValue) || text.includes(searchValue)) {
                    item.style.display = "block";
                } else {
                    item.style.display = "none";
                }
            });
        });
    </script>
    <style>
        .card {
            transition: transform 0.2s;box-shadow 0.2s;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
        .card:hover {
            transform: translateY(-5px);
        }
    </style>
}
