@{
    ViewData["Title"] = "Home Page";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

<div class="container mt-5">
    <div class="text-center">
        <h1 class="display-4 text-primary">Chào mừng đến với Khoa Công Nghệ Thông Tin</h1>
        <p class="lead">Đây là ứng dụng hệ thống Quản Lý Đào Tạo.</p>
    </div>

    <div class="card mt-4 shadow-sm">
        <div class="card-body text-center">
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="IndexAdmin" asp-controller="Admin" class="btn btn-primary btn-lg">
                    <i class="fas fa-user-shield"></i> Trang Quản Lý Admin
                </a>
            }
            else if (User.IsInRole("GiangVien"))
            {
                <a asp-action="IndexGiangVien" asp-controller="GiangVien" class="btn btn-success btn-lg">
                    <i class="fas fa-chalkboard-teacher"></i> Trang Quản Lý Giảng Viên
                </a>
            }
            else if (User.IsInRole("SinhVien"))
            {
                <a asp-action="IndexSinhVien" asp-controller="SinhVien" class="btn btn-warning btn-lg">
                    <i class="fas fa-user-graduate"></i> Trang Quản Lý Sinh Viên
                </a>
            }
            else
            {
                <div class="alert alert-danger mt-3">
                    <i class="fas fa-exclamation-triangle"></i> Vui lòng đăng nhập để sử dụng hệ thống Quản Lý Đào Tạo.
                </div>
            }
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>

</body>
</html>
