@using Microsoft.AspNetCore.Identity
@using QuanLyDaoTao.Controllers
@using QuanLyDaoTaoWeb.Models
@inject SignInManager<ApplicationUser> signInManager
@inject UserManager<ApplicationUser> userManager
@{
    ViewData["Title"] = "Quản Lý Đào Tạo";
}

<div class="home-container">
    <header class="home-header">
        <h1>Chào mừng đến với Khoa Công Nghệ Thông Tin</h1>
        <p>Hệ thống Quản Lý Đào Tạo</p>
        <link rel="stylesheet" href="~/css/Index.css">
    </header>

    <main class="dashboard">
        @if (User.Identity.IsAuthenticated)
        {
            <div class="user-info">
                <div class="avatar">
                    <i class="fas @(User.IsInRole("Admin") ? "fa-user-shield" : 
                                  User.IsInRole("GiangVien") ? "fa-chalkboard-teacher" : 
                                  "fa-user-graduate")"></i>
                </div>
                <h2>Xin chào, @User.Identity.Name!</h2>
                <p>@(User.IsInRole("Admin") ? "Quản trị viên" : 
                     User.IsInRole("GiangVien") ? "Giảng viên" : 
                     "Sinh viên")</p>
            </div>

            <nav class="feature-grid">
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="KhoaIndex" asp-controller="Admin" class="feature-card">
                        <i class="fas fa-university"></i>
                        <h3>Quản Lý Khoa</h3>
                    </a>
                    <a asp-action="SinhVienIndex" asp-controller="Admin" class="feature-card">
                        <i class="fas fa-user-graduate"></i>
                        <h3>Quản Lý Sinh Viên</h3>
                    </a>
                    <a asp-action="GiangVienIndex" asp-controller="Admin" class="feature-card">
                        <i class="fas fa-chalkboard-teacher"></i>
                        <h3>Quản Lý Giảng Viên</h3>
                    </a>
                    <a asp-action="MonHocIndex" asp-controller="Admin" class="feature-card">
                        <i class="fas fa-book"></i>
                        <h3>Quản Lý Môn Học</h3>
                    </a>
                }
                @if (User.IsInRole("GiangVien"))
                {
                    <a asp-action="BaiGiangIndex" asp-controller="GiangVien" class="feature-card">
                        <i class="fas fa-book"></i>
                        <h3>Quản Lý Bài Giảng</h3>
                    </a>
                    <a asp-action="DeCuongIndex" asp-controller="GiangVien" class="feature-card">
                        <i class="fas fa-file-alt"></i>
                        <h3>Quản Lý Đề Cương</h3>
                    </a>
                    <a asp-action="LopHocIndex" asp-controller="GiangVien" class="feature-card">
                        <i class="fas fa-users"></i>
                        <h3>Lớp Học</h3>
                    </a>
                }
                @if (User.IsInRole("SinhVien"))
                {
                    <a asp-action="DangKyLopHocIndex" asp-controller="SinhVien" class="feature-card">
                        <i class="fas fa-edit"></i>
                        <h3>Đăng Ký Lớp Học</h3>
                    </a>
                    <a asp-action="TaiLieuIndex" asp-controller="SinhVien" class="feature-card">
                        <i class="fas fa-book-open"></i>
                        <h3>Tài Liệu Học Tập</h3>
                    </a>
                    <a asp-action="DanhGiaIndex" asp-controller="SinhVien" class="feature-card">
                        <i class="fas fa-star"></i>
                        <h3>Đánh Giá</h3>
                    </a>
                }
            </nav>
        }
        else
        {
            <div class="login-prompt">
                <i class="fas fa-lock"></i>
                <p>Vui lòng đăng nhập để sử dụng hệ thống Quản Lý Đào Tạo</p>
                <a asp-action="Login" asp-controller="Account" class="login-button">Đăng nhập</a>
            </div>
        }
    </main>
</div>

