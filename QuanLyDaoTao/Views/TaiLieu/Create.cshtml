@model QuanLyDaoTaoWeb.Models.TaiLieu

@{
    ViewData["Title"] = "Thêm Tài Liệu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-container">

    <div class="page-header">
        <h1 class="page-title">Thêm Mới Tài Liệu</h1>
    </div>

        <div class="card-body">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">
                    <label asp-for="MaTL" class="control-label">Mã Tài Liệu</label>
                    <input asp-for="MaTL" class="form-control" maxlength="10" />
                    <span asp-validation-for="MaTL" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="TenTL" class="control-label">Tên Tài Liệu</label>
                    <input asp-for="TenTL" class="form-control" maxlength="50" />
                    <span asp-validation-for="TenTL" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="MaBG" class="control-label">Bài Giảng</label>
                    <select asp-for="MaBG" asp-items="ViewBag.BaiGiangList" class="form-control">
                        <option value="">-- Chọn Bài Giảng --</option>
                    </select>
                    <span asp-validation-for="MaBG" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="DuongDan" class="control-label">Tệp tài liệu</label>
                    <input type="file" name="fileUpload" class="form-control" />
                    <span asp-validation-for="DuongDan" class="text-danger"></span>
                    <small class="form-text text-muted">Định dạng hỗ trợ: .pdf, .doc, .docx, .ppt, .pptx</small>
                </div>

                <div class="form-group d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Lưu
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Quay lại
                    </a>
                </div>
            </form>
        </div>


</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
