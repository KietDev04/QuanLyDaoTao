@model QuanLyDaoTaoWeb.Models.DanhGia

@{
    ViewData["Title"] = "Thêm Đánh Giá Mới";
    Layout= "~/Views/Shared/_Layout.cshtml";
}

<div class="page-container">
    <div class="page-header">
        <h1 class="page-title">Thêm Mới Đánh Giá</h1>
    </div>

    <div class="card">
        <div class="card-header bg-primary text-white">
            <h2 class="card-title">Thông Tin Đánh Giá</h2>
        </div>

        <div class="card-body">
            <form asp-action="CreateDanhGia" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">
                    <label asp-for="MaDG" class="control-label">Mã Đánh Giá</label>
                    <input asp-for="MaDG" class="form-control" />
                    <span asp-validation-for="MaDG" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="MaSV" class="control-label">Sinh Viên</label>
                    <select asp-for="MaSV" asp-items="ViewBag.SinhVienList" class="form-control select2">
                        <option value="">-- Chọn Sinh Viên --</option>
                    </select>
                    <span asp-validation-for="MaSV" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="MaMH" class="control-label">Môn Học</label>
                    <select asp-for="MaMH" asp-items="ViewBag.MonHocList" class="form-control select2">
                        <option value="">-- Chọn Môn Học --</option>
                    </select>
                    <span asp-validation-for="MaMH" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="DiemDanhGia" class="control-label">Điểm Đánh Giá</label>
                    <input asp-for="DiemDanhGia" class="form-control" type="number" min="1" max="10" />
                    <span asp-validation-for="DiemDanhGia" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="NhanXet" class="control-label">Nhận Xét</label>
                    <textarea asp-for="NhanXet" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="NhanXet" class="text-danger"></span>
                </div>

                <div class="form-group d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Lưu
                    </button>
                    <a asp-action="DanhGiaIndex" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function () {
            $('.select2').select2({
                theme: 'default' // Dùng theme mặc định nếu không có Bootstrap
            });
        });
    </script>
}
