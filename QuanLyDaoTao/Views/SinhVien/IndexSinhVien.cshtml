@{
    ViewData["Title"] = "Trang Sinh Viên";
}

<div class="container-fluid py-4">
    <div class="card shadow mb-4">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Trang Chủ Sinh Viên</h5>
        </div>
        <div class="card-body">
            <input type="text" id="searchBox" class="form-control mb-3" placeholder="Tìm kiếm danh mục...">
            <div class="row g-4" id="menuContainer">
                @{
                    var menuItems = new[]
                    {
                        new { Title = "Trang Chủ Khoa", Action = "KhoaIndex", Icon = "fa-university" },
                        new { Title = "Trang Bài Giảng", Action = "BaiGiangIndex", Icon = "fa-book" },
                        new { Title = "Trang Tài Liệu", Action = "TaiLieuIndex", Icon = "fa-file" },
                        new { Title = "Trang Đề Cương", Action = "DeCuongIndex", Icon = "fa-list" },
                        new { Title = "Trang Môn Học", Action = "MonHocIndex", Icon = "fa-graduation-cap" },
                        new { Title = "Trang Lớp Học", Action = "LopHocIndex", Icon = "fa-users" },
                        new { Title = "Chương Trình Đào Tạo", Action = "ChuongTrinhDaoTaoIndex", Icon = "fa-tasks" },
                        new { Title = "Đăng Ký Lớp Học", Action = "DangKyLopHocIndex", Icon = "fa-edit" },
                        new { Title = "Trang Đánh Giá", Action = "DanhGiaIndex", Icon = "fa-star" }
                    };
                }
                
                @foreach (var item in menuItems)
                {
                    <div class="col-md-3 menu-item" data-title="@item.Title.ToLower()">
                        <div class="card h-100 text-center">
                            <div class="card-body">
                                <i class="fas @item.Icon fa-3x mb-3 text-primary"></i>
                                <h5 class="card-title">@item.Title</h5>
                                <a asp-action="@item.Action" asp-controller="SinhVien" class="btn btn-warning">
                                    <i class="fas fa-arrow-right"></i> Truy cập
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts { 
    <style> 
        .card { 
            transition: transform 0.2s, box-shadow 0.2s; 
            box-shadow: 0 4px 6px rgba(0,0,0,0.1); 
        } 
        .card:hover { 
            transform: translateY(-5px); 
            box-shadow: 0 6px 12px rgba(0,0,0,0.15);
        }
    </style>
    <script>
        document.getElementById("searchBox").addEventListener("input", function() {
            let filter = this.value.toLowerCase();
            let items = document.querySelectorAll(".menu-item");
            
            items.forEach(item => {
                let title = item.getAttribute("data-title");
                if (title.includes(filter)) {
                    item.style.display = "block";
                } else {
                    item.style.display = "none";
                }
            });
        });
    </script>
}
