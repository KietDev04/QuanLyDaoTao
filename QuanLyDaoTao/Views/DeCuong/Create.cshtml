@model QuanLyDaoTaoWeb.Models.DeCuong

@{
    ViewData["Title"] = "Thêm Đề Cương";
    Layout= "~/Views/Shared/_Layout.cshtml";
}

<div class="page-container">
    <div class="page-header">
        <h1 class="page-title">Thêm Mới Đề Cương</h1>
    </div>

    <div class="card">
        <div class="card-header bg-primary text-white">
            <h2 class="card-title">Thông Tin Đề Cương</h2>
        </div>

        <div class="card-body">
            <form asp-action="CreateDeCuong" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">
                    <label asp-for="MaDC" class="control-label">Mã Đề Cương</label>
                    <input asp-for="MaDC" class="form-control" maxlength="10" />
                    <span asp-validation-for="MaDC" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="MaMH" class="control-label">Môn Học</label>
                    <select asp-for="MaMH" asp-items="ViewBag.MonHocList" class="form-control">
                        <option value="">-- Chọn Môn Học --</option>
                    </select>
                    <span asp-validation-for="MaMH" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="MoTa" class="control-label">Mô Tả</label>
                    <textarea asp-for="MoTa" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="MoTa" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="MucTieu" class="control-label">Mục Tiêu</label>
                    <textarea asp-for="MucTieu" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="MucTieu" class="text-danger"></span>
                </div>

                <div class="form-group d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Lưu
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
