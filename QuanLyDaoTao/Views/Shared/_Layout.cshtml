<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title> Quản Lý Đào Tạo </title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
    <style>
        body { font-family: 'Roboto', sans-serif; background-color: #f8f9fa; }
        .navbar { box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); }
        .dropdown-menu { border-radius: 10px; }
        .footer { background: #212529; color: #fff; padding: 10px 0; text-align: center; }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark py-3">
            <div class="container">
                <a class="navbar-brand fw-bold" href="/">Quản Lý Đào Tạo</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="IndexAdmin">
                                    <i class="fas fa-home"></i> Trang Chủ
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-graduation-cap"></i> Đào Tạo
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="KhoaIndex"><i class="fas fa-university"></i> Quản Lý Khoa</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="ChuongTrinhDaoTaoIndex"><i class="fas fa-book-reader"></i> Chương Trình Đào Tạo</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="MonHocIndex"><i class="fas fa-book"></i> Quản Lý Môn Học</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="LopHocIndex"><i class="fas fa-users"></i> Quản Lý Lớp Học</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="GiangVienIndex"><i class="fas fa-chalkboard-teacher"></i> Quản Lý Giảng Viên</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="SinhVienIndex"><i class="fas fa-user-graduate"></i> Quản Lý Sinh Viên</a></li>
                                    
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-graduation-cap"></i> Tài Liệu
                                </a>
                                <ul class="dropdown-menu">
                                   <li><a class="dropdown-item" asp-controller="Admin" asp-action="TaiLieuIndex"><i class="fas fa-file"></i> Quản Lý Tài Liệu</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="DeCuongIndex"><i class="fas fa-list"></i> Quản Lý Đề Cương</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="BaiGiangIndex"><i class="fas fa-book"></i> Quản Lý Bài Giảng</a></li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-graduation-cap"></i> Học Vụ
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="DangKyLopHocIndex"><i class="fas fa-book"></i> Quản Lý Đăng Ký Lớp Học</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="PhanCongGiangDayIndex"><i class="fas fa-book"></i> Quản Lý Phân Công Giảng Dạy</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="DanhGiaIndex"><i class="fas fa-star"></i> Quản Lý Đánh Giá</a></li>
                                </ul>
                            </li>
                        }
                        @if (User.IsInRole("GiangVien"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="GiangVien" asp-action="IndexGiangVien">
                                    <i class="fas fa-home"></i> Trang Chủ
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-graduation-cap"></i> Đào Tạo
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="GiangVien" asp-action="MonHocIndex"><i class="fas fa-book"></i> Quản Lý Môn Học</a></li>
                                    <li><a class="dropdown-item" asp-controller="GiangVien" asp-action="LopHocIndex"><i class="fas fa-users"></i> Quản Lý Lớp Học</a></li>
                                    <li><a class="dropdown-item" asp-controller="GiangVien" asp-action="ChuongTrinhDaoTaoIndex"><i class="fas fa-book-reader"></i> Chương Trình Đào Tạo</a></li>
                                    <li><a class="dropdown-item" asp-controller="GiangVien" asp-action="PhanCongGiangDayIndex"><i class="fas fa-chalkboard-teacher"></i> Phân Công Giảng Dạy</a></li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-graduation-cap"></i> Tài Liệu
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="GiangVien" asp-action="BaiGiangIndex"><i class="fas fa-book"></i> Quản Lý Bài Giảng</a></li>
                                    <li><a class="dropdown-item" asp-controller="GiangVien" asp-action="TaiLieuIndex"><i class="fas fa-file"></i> Quản Lý Tài Liệu</a></li>
                                    <li><a class="dropdown-item" asp-controller="GiangVien" asp-action="DeCuongIndex"><i class="fas fa-list"></i> Quản Lý Đề Cương</a></li>
                                </ul>
                            </li>
                        }
                        @if (User.IsInRole("SinhVien"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="SinhVien" asp-action="IndexSinhVien">
                                    <i class="fas fa-home"></i> Trang Chủ
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-graduation-cap"></i> Tài Liệu
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="SinhVien" asp-action="BaiGiangIndex"><i class="fas fa-book"></i> Quản Lý Bài Giảng</a></li>
                                    <li><a class="dropdown-item" asp-controller="SinhVien" asp-action="TaiLieuIndex"><i class="fas fa-file"></i> Quản Lý Tài Liệu</a></li>
                                    <li><a class="dropdown-item" asp-controller="SinhVien" asp-action="DeCuongIndex"><i class="fas fa-list"></i> Quản Lý Đề Cương</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav ms-auto">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-danger">Đăng Xuất</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-primary" asp-controller="Account" asp-action="Login">Đăng Nhập</a>
                            </li>
                            <li class="nav-item ms-2">
                                <a class="btn btn-outline-light" asp-controller="Account" asp-action="Register">Đăng Ký</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container mt-4">
        <main>
            @RenderBody()
        </main>
    </div>

    <footer class="bg-dark text-white py-4 mt-5">
    <div class="container">
        <div class="row">
            <!-- Cột 1: Thông tin liên hệ -->
            <div class="col-sm-6">
                <h5>Liên Hệ</h5>
                <p><i class="fas fa-map-marker-alt"></i> Địa chỉ: 123 Đường ABC, Quận X, TP. HCM</p>
                <p><i class="fas fa-envelope"></i> Email: support@quanlydaotao.com</p>
                <p><i class="fas fa-phone"></i> Điện thoại: (028) 1234 5678</p>
            </div>

            <!-- Cột 3: Mạng xã hội -->
            <div class="col-sm-6">
                <h5>Kết Nối Với Chúng Tôi</h5>
                <a href="#" class="text-white me-3"><i class="fab fa-facebook fa-2x"></i>🔗Facebook.SupportQuanLyDaoTao</a>
                <br>
                <a href="#" class="text-white me-3"><i class="fab fa-twitter fa-2x"></i>🔗X.SupportQuanLyDaoTao</a>
                <br>
                <a href="#" class="text-white me-3"><i class="fab fa-linkedin fa-2x"></i>🔗Linkedin.SupportQuanLyDaoTao</a>
            </div>
        </div>                                                                              
        <hr class="bg-light">
        <div class="text-center">
            <p class="mb-0">&copy; 2025 Hệ Thống Quản Lý Đào Tạo. All Rights Reserved.</p>
        </div>
    </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
