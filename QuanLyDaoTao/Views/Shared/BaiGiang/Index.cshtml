@model IEnumerable<QuanLyDaoTaoWeb.Models.BaiGiang>
@using Microsoft.AspNetCore.Identity
@using QuanLyDaoTao.Controllers
@using QuanLyDaoTaoWeb.Models
@inject SignInManager<ApplicationUser> signInManager
@inject UserManager<ApplicationUser> userManager

@{
    ViewData["Title"] = "Quản Lý Bài Giảng";
    var user = await userManager.GetUserAsync(User);
    bool isAdmin = User.IsInRole("Admin");
    bool isGiangVien = User.IsInRole("GiangVien");
    bool isSinhVien = User.IsInRole("SinhVien");
}

<div class="container-fluid py-4">
    @if(isAdmin)
    {
        <a asp-action="IndexAdmin" class="btn btn-info">
            <i class="fas fa-arrow-left"></i> Quay lại
        </a>
    }
    else if (isSinhVien)
    {
        <a asp-action="IndexSinhVien" class="btn btn-info">
            <i class="fas fa-arrow-left"></i> Quay lại
        </a>
    }
    else if (isGiangVien)
    {
        <a asp-action="IndexSinhVien" class="btn btn-info">
            <i class="fas fa-arrow-left"></i> Quay lại
        </a>
        }

    <div class="card shadow">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Danh Sách Bài Giảng</h5>
            @if (isAdmin || isGiangVien)
            {
                <a asp-action="CreateBaiGiang" class="btn btn-light">
                    <i class="fas fa-plus"></i> Thêm mới
                </a>
            }
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>@Html.DisplayNameFor(m => m.MaBG)</th>
                            <th>@Html.DisplayNameFor(m => m.TieuDe)</th>
                            <th>@Html.DisplayNameFor(m => m.MonHoc.TenMH)</th>
                            @if (isAdmin || isGiangVien)
                            {
                                <th>Thao tác</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@Html.DisplayFor(m => item.MaBG)</td>
                                <td>@Html.DisplayFor(m => item.TieuDe)</td>
                                <td>@Html.DisplayFor(m => item.MonHoc.TenMH)</td>
                                @if (isAdmin || isGiangVien)
                                {
                                    <td>
                                        <div class="btn-group">
                                            <a asp-action="EditBaiGiang" asp-route-id="@item.MaBG" class="btn btn-sm btn-warning">
                                                <i class="fas fa-edit"></i> Sửa
                                            </a>
                                            @if (isAdmin)
                                            {
                                                <a asp-action="DeleteBaiGiang" asp-route-id="@item.MaBG" class="btn btn-sm btn-danger">
                                                    <i class="fas fa-trash"></i> Xóa
                                                </a>
                                            }
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.table').DataTable();
        });
    </script>
}