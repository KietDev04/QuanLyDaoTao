@model IEnumerable<QuanLyDaoTaoWeb.Models.ChuongTrinhDaoTao>
@using Microsoft.AspNetCore.Identity
@using QuanLyDaoTao.Controllers
@using QuanLyDaoTaoWeb.Models
@inject SignInManager<ApplicationUser> signInManager
@inject UserManager<ApplicationUser> userManager

@{
    ViewData["Title"] = "Quản Lý Chương Trình Đào Tạo";
    var user = await userManager.GetUserAsync(User);
    bool isAdmin = User.IsInRole("Admin");
    bool isGiangVien = User.IsInRole("GiangVien");
    bool isSinhVien = User.IsInRole("SinhVien");
}


<div class="container-fluid py-4">
    <a asp-action="IndexAdmin" class="btn btn-info">
                <i class="fas fa-plus"></i> Quay lại
            </a>    
    <div class="card shadow">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Danh Sách Chương Trình Đào Tạo</h5>
            @if (isAdmin || isGiangVien)
            {
            <a asp-action="CreateChuongTrinhDaoTao" class="btn btn-light">
                <i class="fas fa-plus"></i> Thêm mới
            </a>
            }
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover datatable">
                    <thead>
                        <tr>
                            <th>@Html.DisplayNameFor(m => m.MaCTDT)</th>
                            <th>@Html.DisplayNameFor(m => m.TenCTDT)</th>
                            <th>@Html.DisplayNameFor(m => m.NamBatDau)</th>
                            <th>@Html.DisplayNameFor(m => m.Khoa.TenKhoa)</th>
                            <th>@Html.DisplayNameFor(m => m.TrangThai)</th>
                            @if (isAdmin || isGiangVien)
                            {
                                <th>Thao tác</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.MaCTDT</td>
                                <td>@item.TenCTDT</td>
                                <td>@item.NamBatDau</td>
                                <td>@item.Khoa?.TenKhoa</td>
                                <td>
                                    <span class="badge @(item.TrangThai ? "bg-success" : "bg-danger")">
                                        @(item.TrangThai ? "Đang áp dụng" : "Ngừng áp dụng")
                                    </span>
                                </td>
                                <td>
                                    <div class="btn-group">
                                        <a asp-action="EditChuongTrinhDaoTao" asp-route-id="@item.MaCTDT" 
                                           class="btn btn-sm btn-warning" title="Sửa">
                                            <i class="fas fa-edit"></i> Sửa
                                        </a>
                                        @if (isAdmin)
                                        {
                                        <a asp-action="DeleteChuongTrinhDaoTao" asp-route-id="@item.MaCTDT" 
                                           class="btn btn-sm btn-danger" title="Xóa">
                                            <i class="fas fa-trash"></i> Xóa
                                        </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.datatable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.10.24/i18n/Vietnamese.json'
                }
            });
        });
    </script>
}