@model IEnumerable<QuanLyDaoTaoWeb.Models.BaiGiang>
@using Microsoft.AspNetCore.Identity
@using QuanLyDaoTaoWeb.Controllers
@using QuanLyDaoTaoWeb.Models
@inject SignInManager<ApplicationUser> signInManager
@inject UserManager<ApplicationUser> userManager

@{
    ViewData["Title"] = "Danh Sách Bài Giảng";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var user = await userManager.GetUserAsync(User);
    bool isAdmin = User.IsInRole("Admin");
    bool isGiangVien = User.IsInRole("GiangVien");
    bool isSinhVien = User.IsInRole("SinhVien");
}

<div class="container-fluid py-4">
   
    <div class="card shadow">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Danh Sách Bài Giảng</h5>
            @if (isAdmin || isGiangVien)
            {
                <a asp-action="Create" class="btn btn-light">
                    <i class="fas fa-plus"></i> Thêm mới
                </a>
            }
        </div>
        <div class="card-body">
            <div class="table-responsive">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Mã Bài Giảng </th>
                    <th>Mã Môn Học</th>
                    <th>Tiêu Đề</th>
                    <th>Nội Dung</th>
                    <th>Thao Tác</th>
                </tr>
            </thead>
            <tbody id="tableBody">
                        @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.MaBG</td>
                        <td>@item.MaMH</td>
                        <td>@item.TieuDe</td>
                        <td>@item.NoiDung</td>
                        <td>
                            <div class="table-actions">
                                <a asp-action="Edit" asp-route-id="@item.MaBG" class="btn btn-secondary">
                                    <i class="fas fa-edit"></i>
                                    <span>Sửa</span>
                                </a>
                                
                                <button onclick="deleteItem(@item.MaBG)" class="btn btn-danger">
                                    <i class="fas fa-trash"></i>
                                    <span>Xóa</span>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.table').DataTable();
        });
    </script>
}