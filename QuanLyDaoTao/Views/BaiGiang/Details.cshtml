@model QuanLyDaoTaoWeb.Models.BaiGiang

@{
    ViewData["Title"] = "Chi tiết Bài Giảng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Chi tiết Bài Giảng</h5>
            <a asp-action="BaiGiangIndex" class="btn btn-light">
                <i class="fas fa-arrow-left"></i> Quay lại
            </a>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-2">Mã Bài Giảng:</dt>
                <dd class="col-sm-10">@Model.MaBG</dd>

                <dt class="col-sm-2">Mã Môn Học:</dt>
                <dd class="col-sm-10">@Model.MaMH</dd>

                <dt class="col-sm-2">Tên Môn Học:</dt>
                <dd class="col-sm-10">@Model.MonHoc?.TenMH</dd>

                <dt class="col-sm-2">Tiêu Đề:</dt>
                <dd class="col-sm-10">@Model.TieuDe</dd>

                <dt class="col-sm-2">Nội Dung:</dt>
                <dd class="col-sm-10">@Model.NoiDung</dd>
            </dl>

            <div class="mt-4">
                <a asp-action="EditBaiGiang" asp-route-id="@Model.MaBG" class="btn btn-warning">
                    <i class="fas fa-edit"></i> Sửa
                </a>
                <a asp-action="DeleteBaiGiang" asp-route-id="@Model.MaBG" class="btn btn-danger" 
                   onclick="return confirm('Bạn có chắc chắn muốn xóa bài giảng này?');">
                    <i class="fas fa-trash"></i> Xóa
                </a>
            </div>
        </div>
    </div>
</div> 