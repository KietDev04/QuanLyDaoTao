@model QuanLyDaoTaoWeb.Models.BaiGiang

@{
    ViewData["Title"] = "Thêm Bài Giảng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-container">
    <div class="page-header">
        <h1 class="page-title">Thêm Mới Bài Giảng</h1>
    </div>

    <div class="card">
        <div class="card-header bg-primary text-white">
            <h2 class="card-title">Thông Tin Bài Giảng</h2>
        </div>

        <div class="card-body">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">
                    <label asp-for="MaBG" class="control-label">Mã Bài Giảng</label>
                    <input asp-for="MaBG" class="form-control" />
                    <span asp-validation-for="MaBG" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="MaMH" class="control-label">Môn Học</label>
                    <select asp-for="MaMH" asp-items="ViewBag.MonHocList" class="form-control">
                        <option value="">-- Chọn Môn Học --</option>
                    </select>
                    <span asp-validation-for="MaMH" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="TieuDe" class="control-label">Tiêu Đề</label>
                    <input asp-for="TieuDe" class="form-control" />
                    <span asp-validation-for="TieuDe" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="NoiDung" class="control-label">Nội Dung</label>
                    <textarea asp-for="NoiDung" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="NoiDung" class="text-danger"></span>
                </div>

                <div class="form-group d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Lưu
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
